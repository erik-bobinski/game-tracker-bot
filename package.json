{
  "name": "game-tracker-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "github.com/erik-bobinski",
  "license": "ISC",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "admin": "bun src/admin/index.ts",
    "verify": "bun run test:live",
    "test:live": "bun src/verify/live.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "oxlint",
    "knip": "knip",
    "test": "bun test",
    "audit": "bun audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run build:web && bun run knip && bun run test && bun run audit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.6",
    "@effect/sql-sqlite-bun": "4.1.6",
    "@fontsource/inter": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "dfx": "1.1.1",
    "effect": "4.1.6",
    "satori": "0.33.5"
  },
  "devDependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@859a30f",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@859a30f",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@oxlint/plugins": "1.89.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "knip": "6.43.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "trustedDependencies": [],
  "patchedDependencies": {
    "dfx@1.1.1": "patches/dfx@1.1.1.patch"
  }
}
