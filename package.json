{
  "name": "game-tracker-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "github.com/erik-bobinski",
  "license": "ISC",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "admin": "bun src/admin/index.ts",
    "verify": "bun src/verify/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "bun test",
    "audit": "bun audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run audit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@effect/sql-sqlite-bun": "4.0.6",
    "@fontsource/inter": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "dfx": "1.1.1",
    "effect": "4.0.6",
    "satori": "0.33.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.4",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "trustedDependencies": [],
  "patchedDependencies": {
    "dfx@1.1.1": "patches/dfx@1.1.1.patch"
  }
}
